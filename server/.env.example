NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-domain.com

# Use either DATABASE_URL or the individual MYSQL_* values.
DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/MYSQL_DATABASE
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=founder_finance
MYSQL_USER=founder_finance_user
MYSQL_PASSWORD=change_me

JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeThisPassword123!

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.com
SMTP_PASSWORD=change_me
SMTP_FROM="MONEX <no-reply@your-domain.com>"
